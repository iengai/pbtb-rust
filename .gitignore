
/target/
**/*.rs.bk
.idea/
.vscode/
.DS_Store

.env
.env.local
/terraform/envs/dev/.terraform/
/terraform/envs/dev/terraform.tfstate
/terraform/envs/dev/terraform.tfstate.backup
# Saved plan files, including the gated ones nat_rebuild.py writes per step.
/terraform/envs/dev/*.tfplan
# Telegram user ids of the people allowed to drive the bot. This repo is public;
# the ids identify real accounts, so they stay out of it. See the .example file.
/terraform/envs/dev/telebot-allowlist.auto.tfvars
# The Sentry DSN and anything else terraform needs that must not be public.
/terraform/envs/dev/secrets.auto.tfvars
/terraform/modules/lambda/.build/
.devcontainer/docker/dynamodb/
.claude/settings.local.json
.claude/worktrees/
.claude/workflows/

# Python bytecode from scripts/ops.
__pycache__/

# Local agent-tool state (reasonix), machine-specific and not shared.
/.reasonix/
/reasonix.toml

# Raw backtest output, logs and the S3 template mirror of scripts/backtest_templates.py.
/.cache/
