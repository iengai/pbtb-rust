# Copy to `.env` for local development. All three are public identifiers, not
# secrets: the SPA is a public OAuth client and the API is behind its own auth.

# The REST/MCP Lambda's Function URL, WITH the trailing slash. It is also sent
# as the OAuth `resource`, and the token's `aud` must equal it byte for byte.
VITE_API_URL=https://wpgsvdyyl6rb4omtrgb7ox6weu0krirm.lambda-url.ap-northeast-1.on.aws/

# The WorkOS AuthKit issuer. The console uses `${VITE_OAUTH_ISSUER}/oauth2/authorize`
# and `/oauth2/token` (authorization code + PKCE, no client secret).
VITE_OAUTH_ISSUER=https://growing-starlight-99-staging.authkit.app

# The Connect application registered with the redirect URIs
# http://localhost:5173/callback and https://iengai.github.io/pbtb-rust/callback.
VITE_OAUTH_CLIENT_ID=client_01M227S251T5NA8GTGHWT1QAVB

# Optional: the NAT egress IP shown on the Account page for API-key whitelisting.
# VITE_EGRESS_IP=
